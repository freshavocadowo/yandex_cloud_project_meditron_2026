{
  "art_hyper": {
    "markers": ["Гипертоническая болезнь", "ГБ", "Артериальная гипертензия", "АГ"],
    "type": "binary",
    "negation": ["отрицает", "не отмечалась"]
  },
  "atr_fibril": {
    "markers": ["Фибрилляция предсердий", "Трепетание предсердий", "фибрилляция предсердий", "постоянная форма"],
    "type": "binary"
  },
  "ckd": {
    "markers": ["ХБП"],
    "type": "categorical",
    "regex": "(ХБП\\s+[\\dIVX]+[А-Яа-я]?)"
  },
  "copd": {
    "markers": ["ХОБЛ"],
    "type": "binary"
  },
  "diagnosis_icd": {
    "markers": ["Код МКБ-10", "МКБ-10"],
    "type": "code",
    "regex": "МКБ-10\\s+([A-Z]\\d{2}\\.\\d)"
  },
  "dm": {
    "markers": ["Сахарный диабет", "СД 2"],
    "type": "binary",
    "negation": ["отрицает"]
  },
  "hf": {
    "markers": ["ХСН"],
    "type": "categorical",
    "regex": "ХСН\\s+([\\dIVX]+[А-Яа-я]?)[,\\s]+ФК\\s+([\\dIVX]+)",
    "format": "ХСН {0}, ФК {1}"
  },
  "killip": {
    "markers": ["Killip"],
    "type": "categorical",
    "regex": "Killip[\\s:\\u00a0]*([IVX]+|\\d)",
    "map": {"I": 1, "II": 2, "III": 3, "IV": 4, "1": 1, "2": 2, "3": 3, "4": 4}
  },
  "mi_localisation": {
    "markers": ["передней стенки", "нижней стенки", "боковой стенки", "инфаркт миокарда", "Нестабильная стенокардия", "прогрессирующая стенокардия"],
    "type": "categorical",
    "section": "diagnosis",
    "map": [
      {"pattern": "передней стенки|передняя стенка", "value": "A"},
      {"pattern": "нижней стенки|нижняя стенка", "value": "I"},
      {"pattern": "боковой стенки|боковая стенка", "value": "L"},
      {"pattern": "инфаркт миокарда|Нестабильная стенокардия|прогрессирующая стенокардия", "value": "N"}
    ]
  },
  "tlt": {
    "markers": ["тромболизис", "ТЛТ"],
    "type": "binary"
  },
  "type_acs": {
    "markers": ["с подъёмом ST", "с элевацией ST", "без подъёма ST", "Нестабильная стенокардия", "прогрессирующая стенокардия"],
    "type": "categorical",
    "map": [
      {"pattern": "с подъёмом ST|с элевацией ST", "value": "STEMI"},
      {"pattern": "без подъёма ST|Элевации ST нет|Подъёма ST не зарегистрировано", "value": "NSTEMI"},
      {"pattern": "Нестабильная стенокардия|прогрессирующая стенокардия", "value": "NSTEMI"}
    ]
  },

  "bmi": {
    "markers": ["ИМТ"],
    "type": "numeric",
    "regex": "ИМТ\\s+(\\d{1,2}[.,]?\\d?)"
  },
  "bp": {
    "markers": ["АД"],
    "type": "special",
    "regex": "АД\\s+(\\d{2,3})\\s*/\\s*(\\d{2,3})",
    "format": "{0}/{1}"
  },
  "bpm": {
    "markers": ["пульс"],
    "type": "numeric",
    "regex": "пульс\\s+(\\d{2,3})\\s+в минуту"
  },
  "height": {
    "markers": ["Рост"],
    "type": "numeric",
    "regex": "Рост\\s+(\\d{3})\\s*см"
  },
  "rr": {
    "markers": ["ЧДД"],
    "type": "numeric",
    "regex": "ЧДД\\s+(\\d{1,2})"
  },
  "smoking": {
    "markers": ["Не курит", "Бросил курить", "Прекратила курить", "Курит"],
    "type": "categorical",
    "map": [
      {"pattern": "Не курит", "value": "Не курит"},
      {"pattern": "Бросил курить|Прекратила курить", "value": "Бросил курить"},
      {"pattern": "Курит", "value": "Курит"}
    ]
  },
  "spo2": {
    "markers": ["SpO2"],
    "type": "numeric",
    "regex": "SpO2\\s+(\\d{2,3})\\s*%"
  },
  "weight": {
    "markers": ["масса тела", "вес"],
    "type": "numeric",
    "regex": "(?:масса тела|вес)\\s+(\\d{2,3})\\s*кг"
  },

  "ecg_avb": {
    "markers": ["АВ-блокада", "АВ блокада", "атриовентрикулярная блокада"],
    "type": "binary"
  },
  "ecg_bpm": {
    "markers": ["ЧСС"],
    "type": "numeric",
    "regex": "ЧСС\\s+(\\d{2,3})\\s*уд/мин",
    "section": "ecg"
  },
  "ecg_elevation": {
    "markers": ["Элевация ST", "Подъём сегмента ST", "Подъём ST", "Подъёма ST не зарегистрировано", "Элевации ST нет"],
    "type": "binary",
    "negation": ["Подъёма ST не зарегистрировано", "Элевации ST нет"]
  },
  "ecg_rythm": {
    "markers": ["синусовый ритм", "фибрилляция предсердий", "трепетание предсердий", "ФП", "синусовый"],
    "type": "categorical",
    "map": [
      {"pattern": "синусовый ритм|синусовый", "value": "синусовый"},
      {"pattern": "фибрилляция предсердий|ФП", "value": "фибрилляция предсердий"},
      {"pattern": "трепетание предсердий", "value": "трепетание предсердий"}
    ]
  },

  "echo_ef": {
    "markers": ["ФВ ЛЖ", "ФВ"],
    "type": "numeric",
    "regex": "ФВ\\s*ЛЖ\\s+(\\d{2,3})\\s*%"
  },
  "echo_lvd": {
    "markers": ["КДР ЛЖ", "КДР"],
    "type": "numeric",
    "regex": "КДР\\s*ЛЖ\\s+(\\d{2,3})\\s*мм"
  },
  "echo_lvd_2": {
    "markers": ["ЛП"],
    "type": "numeric",
    "regex": "ЛП\\s+(\\d{2,3})\\s*мм"
  },
  "echo_mr": {
    "markers": ["Митральная регургитация", "митральная недостаточность"],
    "type": "categorical",
    "regex": "(Митральная регургитация\\s+[\\dIVX]+\\s*(?:ст\\.?|степени)?)"
  },
  "echo_zone": {
    "markers": ["Гипокинез", "акинез", "гипокинезия"],
    "type": "categorical",
    "regex": "((?:Гипокинез|акинез|Гипокинезия)\\s+[а-яё]+\\s+стенки)"
  },

  "rg_date": {
    "markers": ["Рентгенограмма", "Рентгенография", "Р-графия"],
    "type": "date_near_marker",
    "regex": "(?:Рентгенограмма|Рентгенография|Р-графия)[^\\d]{0,120}(\\d{2}\\.\\d{2}\\.\\d{4})"
  },
  "rg_pc": {
    "markers": ["венозн", "отёк лёгк", "интерстициальн", "застой"],
    "type": "categorical",
    "section": "xray",
    "map": [
      {"pattern": "интерстициальн", "value": "Признаки интерстициального отёка лёгких"},
      {"pattern": "венозн", "value": "Признаки венозного застоя в лёгких"},
      {"pattern": "застой", "value": "Признаки венозного застоя в лёгких"},
      {"pattern": "отёк лёгк", "value": "Признаки отёка лёгких"}
    ]
  },

  "ca_date": {
    "markers": ["Коронарография", "КАГ"],
    "type": "date_near_marker",
    "regex": "(\\d{2}\\.\\d{2}\\.\\d{4})[^\\d]{0,30}(?:выполнена|проведена)[^\\d]{0,30}(?:КАГ|Коронарография)|(?:Коронарография|КАГ)[^\\d]{0,60}(\\d{2}\\.\\d{2}\\.\\d{4})"
  },
  "ca_fact": {
    "markers": ["выполнена селективная КАГ", "Выполнена коронарография", "Коронарография от", "отказ от коронарографии", "коронарография не выполнена", "документирован отказ"],
    "type": "categorical",
    "section": "coronary",
    "map": [
      {"pattern": "отказ|не выполнена", "value": "R"},
      {"pattern": "выполнена|Коронарография от", "value": "Y"}
    ],
    "default_if_not_found": "N"
  },
  "ca_lad": {
    "markers": ["ПМЖВ"],
    "type": "scale",
    "section": "coronary",
    "regex": "ПМЖВ[:\\s]*([^;.\\n]*)"
  },
  "rca": {
    "markers": ["ПКА"],
    "type": "scale",
    "section": "coronary",
    "regex": "ПКА[:\\s]*([^;.\\n]*)"
  },

  "card_trop": {
    "markers": ["тропониновый тест", "тропонин"],
    "type": "categorical",
    "regex": "тропониновый тест\\s*[—\\-]\\s*(положительный|отрицательный)"
  },
  "crea": {
    "markers": ["креатинин"],
    "type": "numeric",
    "regex": "креатинин\\s+(\\d{1,3}[.,]?\\d?)"
  },
  "glu": {
    "markers": ["глюкоза"],
    "type": "numeric",
    "regex": "глюкоза\\s+(\\d{1,2}[.,]?\\d?)"
  },
  "hb": {
    "markers": ["гемоглобин"],
    "type": "numeric",
    "regex": "гемоглобин\\s+(\\d{2,3})"
  },
  "ldl": {
    "markers": ["ХС-ЛПНП"],
    "type": "numeric",
    "regex": "ХС-ЛПНП\\s+(\\d[.,]?\\d?)"
  },
  "leucocytes": {
    "markers": ["лейкоциты"],
    "type": "numeric",
    "regex": "лейкоциты\\s+(\\d[.,]?\\d?)"
  },
  "thrombocytes": {
    "markers": ["тромбоциты"],
    "type": "numeric",
    "regex": "тромбоциты\\s+(\\d{2,3})"
  },
  "tot_chol": {
    "markers": ["общий холестерин"],
    "type": "numeric",
    "regex": "общий холестерин\\s+(\\d[.,]?\\d?)"
  },

  "2_aag": {
    "markers": ["Клопидогрел", "Тикагрелор", "Прасугрел"],
    "type": "drug",
    "section": "meds",
    "drug_regex": "(?:^|[\\s\\d.])(Клопидогрел|Тикагрелор|Прасугрел)\\s+\\d+\\s*мг[^\\n]*"
  },
  "ace_ing_sartan": {
    "markers": ["Периндоприл", "Рамиприл", "Лозартан", "Эналаприл", "Лизиноприл", "Валсартан", "Кандесартан", "Телмисартан", "Ирбесартан", "Олмесартан"],
    "type": "drug",
    "section": "meds",
    "drug_regex": "(?:^|[\\s\\d.])(Периндоприл|Рамиприл|Лозартан|Эналаприл|Лизиноприл|Валсартан|Кандесартан|Телмисартан|Ирбесартан|Олмесартан)\\s+\\d+\\s*мг[^\\n]*"
  },
  "anticoagulant": {
    "markers": ["Апиксабан", "Ривароксабан", "Дабигатран", "Эдоксабан", "Варфарин"],
    "type": "drug",
    "section": "meds",
    "drug_regex": "(?:^|[\\s\\d.])(Апиксабан|Ривароксабан|Дабигатран|Эдоксабан|Варфарин)\\s+\\d+\\s*мг[^\\n]*"
  },
  "aspirin": {
    "markers": ["Ацетилсалициловая кислота", "АСК", "Аспирин"],
    "type": "drug",
    "section": "meds",
    "drug_regex": "(?:^|[\\s\\d.])(Ацетилсалициловая кислота|АСК|Аспирин)\\s+\\d+\\s*мг[^\\n]*"
  },
  "bb": {
    "markers": ["Бисопролол", "Метопролол", "Карведилол", "Небиволол", "Атенолол", "Бетаксолол"],
    "type": "drug",
    "section": "meds",
    "drug_regex": "(?:^|[\\s\\d.])(Бисопролол|Метопролол|Карведилол|Небиволол|Атенолол|Бетаксолол)\\s+\\d+\\s*мг[^\\n]*"
  },
  "statin": {
    "markers": ["Аторвастатин", "Розувастатин", "Симвастатин", "Правастатин", "Питавастатин", "Флувастатин", "Ловастатин"],
    "type": "drug",
    "section": "meds",
    "drug_regex": "(?:^|[\\s\\d.])(Аторвастатин|Розувастатин|Симвастатин|Правастатин|Питавастатин|Флувастатин|Ловастатин)\\s+\\d+\\s*мг[^\\n]*"
  }
}